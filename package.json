{
  "name": "oblitero",
  "version": "0.2.0",
  "private": true,
  "description": "A Chrome extension (Manifest V3) to merge, split, sign and redact PDF files. 100% local, no account.",
  "keywords": [
    "chrome-extension",
    "manifest-v3",
    "pdf",
    "merge",
    "redact",
    "privacy"
  ],
  "license": "MIT",
  "author": "Bruno Bellenoue",
  "homepage": "https://github.com/kodetix-fr/oblitero#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodetix-fr/oblitero.git"
  },
  "bugs": {
    "url": "https://github.com/kodetix-fr/oblitero/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test \"*.test.js\"",
    "test:e2e": "node --test --test-reporter=spec --test-concurrency=1 --test-timeout=180000 \"test/e2e/*.e2e.mjs\"",
    "lint": "eslint .",
    "package": "node scripts/package.mjs",
    "icons": "node scripts/make-icons.mjs",
    "bench": "node scripts/bench.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/chrome": "0.3.4",
    "@types/node": "22.20.4",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "playwright-core": "1.57.0",
    "typescript": "7.0.2"
  }
}
